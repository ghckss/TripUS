PORT=3000
DATABASE_URL=postgresql://tripus:tripus_local@localhost:5432/tripus

# Deterministic local planner. Set to openai only with both values below.
AI_PLANNER_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# Deterministic local search/routes. Google mode requires billing-enabled Places API (New) and Routes API.
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

POSTGRES_DB=tripus
POSTGRES_USER=tripus
POSTGRES_PASSWORD=tripus_local
POSTGRES_PORT=5432
