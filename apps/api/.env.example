PORT=3000
DATABASE_URL=postgresql://tripus:tripus_local@localhost:5432/tripus

# Deterministic local planner. Set to openai only with both values below.
AI_PLANNER_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1200

# Deterministic local search/routes. Google mode requires billing-enabled Places API (New) and Routes API.
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# Original photos have no aggregate user quota. A 100 MB per-file safety limit applies.
# local stores under PHOTO_LOCAL_DIRECTORY; s3 preserves originals and serves signed URLs.
PHOTO_STORAGE_PROVIDER=local
PHOTO_LOCAL_DIRECTORY=.data/photos
API_PUBLIC_URL=http://localhost:3000
PHOTO_S3_BUCKET=
AWS_REGION=ap-northeast-2
PHOTO_S3_ENDPOINT=

# Use jwt outside local development. Client ID lists are comma-separated.
AUTH_MODE=development
ACCESS_TOKEN_SECRET=tripus-development-secret-change-me
ACCESS_TOKEN_ISSUER=tripus-api
ACCESS_TOKEN_AUDIENCE=tripus-mobile
GOOGLE_OIDC_CLIENT_IDS=
APPLE_OIDC_CLIENT_IDS=
