# Optional. When omitted in a Development Build, the Expo dev-server host on port 3000 is used.
# Android Emulator override example: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Use production to hide the local development login button.
EXPO_PUBLIC_AUTH_MODE=development
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# CNG/native build-time values. Do not prefix these with EXPO_PUBLIC.
# Restrict each key in Google Cloud to its platform app and Maps SDK only.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
