{
  "expo": {
    "name": "TripUS",
    "slug": "tripus",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/tripus-app-icon-t-filled-1024.png",
    "scheme": "tripus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/tripus-app-icon-t-filled-1024.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.tripus.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tripus.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#CB6745",
        "foregroundImage": "./assets/images/android-icon-transparent.png",
        "backgroundImage": "./assets/branding/tripus-app-icon-t-filled-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/branding/tripus-google-play-icon-t-filled-512.png"
    },
    "plugins": [
      "./plugins/with-hidden-dev-menu-fab",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "TripUS에서 여행 사진을 선택할 수 있도록 사진 접근을 허용해 주세요."
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e4d2c948-bbf4-43b3-89c2-185b2b452686"
      }
    },
    "owner": "ghckss93"
  }
}
