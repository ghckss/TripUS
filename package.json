{
  "name": "tripus",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "contracts:generate": "pnpm --filter @tripus/api openapi:generate && pnpm --filter @tripus/api-client generate",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:up": "docker compose up -d postgres",
    "dev": "pnpm -r --parallel --if-present dev",
    "e2e:maestro": "pnpm --filter @tripus/mobile e2e:maestro",
    "deploy:bootstrap": "pnpm --filter @tripus/infra bootstrap",
    "deploy:aws": "pnpm --filter @tripus/infra deploy",
    "deploy:diff": "pnpm --filter @tripus/infra diff",
    "deploy:smoke": "pnpm --filter @tripus/infra smoke",
    "deploy:synth": "pnpm --filter @tripus/infra synth",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
