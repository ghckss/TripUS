{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/v1/trips/{tripId}/ai-plans": {
      "post": {
        "operationId": "AiPlanningController_generate",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateAiPlanDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateAiPlanResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "ai-planning"
        ]
      }
    },
    "/v1/trips/{tripId}/itinerary": {
      "get": {
        "operationId": "ItinerariesController_get",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItineraryResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "itineraries"
        ]
      },
      "put": {
        "operationId": "ItinerariesController_replace",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceItineraryDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItineraryUpdateResultDto"
                }
              }
            }
          }
        },
        "tags": [
          "itineraries"
        ]
      }
    },
    "/v1/trips/{tripId}/places": {
      "get": {
        "operationId": "PlacesController_list",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SavedPlaceResponseDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "places"
        ]
      },
      "post": {
        "operationId": "PlacesController_create",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSavedPlaceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavePlaceResultDto"
                }
              }
            }
          }
        },
        "tags": [
          "places"
        ]
      }
    },
    "/v1/trips": {
      "get": {
        "operationId": "TripsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TripResponseDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "trips"
        ]
      },
      "post": {
        "operationId": "TripsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTripDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "trips"
        ]
      }
    },
    "/v1/trips/{tripId}": {
      "get": {
        "operationId": "TripsController_get",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "trips"
        ]
      }
    },
    "/v1/trips/{tripId}/completion": {
      "post": {
        "operationId": "TripRecordsController_complete",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteTripDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteTripResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "trip-records"
        ]
      }
    }
  },
  "info": {
    "title": "TripUS API",
    "description": "TripUS mobile application API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {}
      },
      "TravelStyle": {
        "type": "string",
        "enum": [
          "balanced",
          "food",
          "highlights",
          "relaxed"
        ]
      },
      "GenerateAiPlanDto": {
        "type": "object",
        "properties": {
          "style": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TravelStyle"
              }
            ]
          }
        },
        "required": [
          "style"
        ]
      },
      "ItineraryUpdateStatus": {
        "type": "string",
        "enum": [
          "updated",
          "conflict"
        ]
      },
      "ItinerarySource": {
        "type": "string",
        "enum": [
          "manual",
          "ai"
        ]
      },
      "VisitStatus": {
        "type": "string",
        "enum": [
          "rated",
          "unrated",
          "not_visited"
        ]
      },
      "ItineraryItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "savedPlaceId": {
            "type": "string",
            "format": "uuid"
          },
          "placeName": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "position": {
            "type": "number",
            "nullable": true
          },
          "locked": {
            "type": "boolean"
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ItinerarySource"
              }
            ]
          },
          "visitStatus": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/VisitStatus"
              }
            ]
          },
          "rating": {
            "type": "number",
            "nullable": true
          },
          "review": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "savedPlaceId",
          "placeName",
          "locked",
          "source"
        ]
      },
      "UnplacedPlaceResponseDto": {
        "type": "object",
        "properties": {
          "savedPlaceId": {
            "type": "string",
            "format": "uuid"
          },
          "placeName": {
            "type": "string"
          }
        },
        "required": [
          "savedPlaceId",
          "placeName"
        ]
      },
      "ItineraryResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItineraryItemResponseDto"
            }
          },
          "unplaced": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnplacedPlaceResponseDto"
            }
          }
        },
        "required": [
          "items",
          "unplaced"
        ]
      },
      "GenerateAiPlanResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ItineraryUpdateStatus"
              }
            ]
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "itinerary": {
            "$ref": "#/components/schemas/ItineraryResponseDto"
          },
          "style": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TravelStyle"
              }
            ]
          }
        },
        "required": [
          "status",
          "conflicts",
          "itinerary",
          "style"
        ]
      },
      "ReplaceItineraryItemDto": {
        "type": "object",
        "properties": {
          "savedPlaceId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "position": {
            "type": "number",
            "minimum": 0
          },
          "locked": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "savedPlaceId",
          "date",
          "position"
        ]
      },
      "ReplaceItineraryDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReplaceItineraryItemDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ItineraryUpdateResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ItineraryUpdateStatus"
              }
            ]
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "itinerary": {
            "$ref": "#/components/schemas/ItineraryResponseDto"
          }
        },
        "required": [
          "status",
          "conflicts",
          "itinerary"
        ]
      },
      "PlaceTag": {
        "type": "string",
        "enum": [
          "attraction",
          "food",
          "cafe",
          "shopping",
          "lodging",
          "transport",
          "activity",
          "other"
        ]
      },
      "PlacePreference": {
        "type": "string",
        "enum": [
          "must_visit",
          "want_to_visit",
          "if_time_allows"
        ]
      },
      "SavedPlaceResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tripId": {
            "type": "string",
            "format": "uuid"
          },
          "googlePlaceId": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "tag": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlaceTag"
              }
            ]
          },
          "preference": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlacePreference"
              }
            ]
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "tripId",
          "name",
          "tag",
          "preference"
        ]
      },
      "CreateSavedPlaceDto": {
        "type": "object",
        "properties": {
          "googlePlaceId": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "name": {
            "type": "string",
            "example": "국립현대미술관 서울",
            "maxLength": 180
          },
          "address": {
            "type": "string",
            "maxLength": 300,
            "nullable": true
          },
          "tag": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlaceTag"
              }
            ]
          },
          "preference": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlacePreference"
              }
            ]
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "name",
          "tag",
          "preference"
        ]
      },
      "SavePlaceStatus": {
        "type": "string",
        "enum": [
          "created",
          "already_exists"
        ]
      },
      "SavePlaceResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SavePlaceStatus"
              }
            ]
          },
          "place": {
            "$ref": "#/components/schemas/SavedPlaceResponseDto"
          }
        },
        "required": [
          "status",
          "place"
        ]
      },
      "TripResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "active": {
            "type": "boolean"
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "title",
          "destination",
          "timezone",
          "startDate",
          "endDate",
          "active"
        ]
      },
      "CreateTripDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "서울 가을 여행",
            "maxLength": 120
          },
          "destination": {
            "type": "string",
            "example": "서울",
            "maxLength": 120
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul",
            "maxLength": 64
          },
          "startDate": {
            "type": "string",
            "example": "2026-10-31",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "example": "2026-11-02",
            "format": "date"
          }
        },
        "required": [
          "title",
          "destination",
          "timezone",
          "startDate",
          "endDate"
        ]
      },
      "CompleteTripItemDto": {
        "type": "object",
        "properties": {
          "itineraryItemId": {
            "type": "string",
            "format": "uuid"
          },
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "notVisited": {
            "type": "boolean",
            "default": false
          },
          "review": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "itineraryItemId"
        ]
      },
      "CompleteTripDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompleteTripItemDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CompleteTripResponseDto": {
        "type": "object",
        "properties": {
          "trip": {
            "$ref": "#/components/schemas/TripResponseDto"
          },
          "itinerary": {
            "$ref": "#/components/schemas/ItineraryResponseDto"
          }
        },
        "required": [
          "trip",
          "itinerary"
        ]
      }
    }
  }
}
