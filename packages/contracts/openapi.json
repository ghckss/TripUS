  "info": {
    "title": "TripUS API",
    "description": "TripUS mobile application API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {}
      },
      "SocialAuthProvider": {
        "type": "string",
        "enum": [
          "google",
          "apple"
        ]
      },
      "SocialLoginDto": {
        "type": "object",
        "properties": {
          "provider": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SocialAuthProvider"
              }
            ]
          },
          "idToken": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "provider",
          "idToken"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 900
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresInSeconds",
          "user"
        ]
      },
      "RefreshSessionDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TravelStyle": {
        "type": "string",
        "enum": [
          "balanced",
          "food",
          "highlights",
          "relaxed"
        ]
      },
      "GenerateAiPlanDto": {
        "type": "object",
        "properties": {
          "style": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TravelStyle"
              }
            ]
          }
        },
        "required": [
          "style"
        ]
      },
      "AiPlanGenerationStatus": {
        "type": "string",
        "enum": [
          "generated",
          "conflict",
          "unavailable"
        ]
      },
      "ItinerarySource": {
        "type": "string",
        "enum": [
          "manual",
          "ai"
        ]
      },
      "VisitStatus": {
        "type": "string",
        "enum": [
          "rated",
          "unrated",
          "not_visited"
        ]
      },
      "ItineraryItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "savedPlaceId": {
            "type": "string",
            "format": "uuid"
          },
          "placeName": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "position": {
            "type": "number",
            "nullable": true
          },
          "locked": {
            "type": "boolean"
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ItinerarySource"
              }
            ]
          },
          "visitStatus": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/VisitStatus"
              }
            ]
          },
          "rating": {
            "type": "number",
            "nullable": true
          },
          "review": {
            "type": "string",
            "nullable": true
          }
