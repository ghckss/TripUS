{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/v1/trips/{tripId}/places": {
      "get": {
        "operationId": "PlacesController_list",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SavedPlaceResponseDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "places"
        ]
      },
      "post": {
        "operationId": "PlacesController_create",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSavedPlaceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavePlaceResultDto"
                }
              }
            }
          }
        },
        "tags": [
          "places"
        ]
      }
    },
    "/v1/trips": {
      "get": {
        "operationId": "TripsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TripResponseDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "trips"
        ]
      },
      "post": {
        "operationId": "TripsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTripDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "trips"
        ]
      }
    },
    "/v1/trips/{tripId}": {
      "get": {
        "operationId": "TripsController_get",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "trips"
        ]
      }
    }
  },
  "info": {
    "title": "TripUS API",
    "description": "TripUS mobile application API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {}
      },
      "PlaceTag": {
        "type": "string",
        "enum": [
          "attraction",
          "food",
          "cafe",
          "shopping",
          "lodging",
          "transport",
          "activity",
          "other"
        ]
      },
      "PlacePreference": {
        "type": "string",
        "enum": [
          "must_visit",
          "want_to_visit",
          "if_time_allows"
        ]
      },
      "SavedPlaceResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tripId": {
            "type": "string",
            "format": "uuid"
          },
          "googlePlaceId": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "tag": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlaceTag"
              }
            ]
          },
          "preference": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlacePreference"
              }
            ]
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "tripId",
          "name",
          "tag",
          "preference"
        ]
      },
      "CreateSavedPlaceDto": {
        "type": "object",
        "properties": {
          "googlePlaceId": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "name": {
            "type": "string",
            "example": "국립현대미술관 서울",
            "maxLength": 180
          },
          "address": {
            "type": "string",
            "maxLength": 300,
            "nullable": true
          },
          "tag": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlaceTag"
              }
            ]
          },
          "preference": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlacePreference"
              }
            ]
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "name",
          "tag",
          "preference"
        ]
      },
      "SavePlaceStatus": {
        "type": "string",
        "enum": [
          "created",
          "already_exists"
        ]
      },
      "SavePlaceResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SavePlaceStatus"
              }
            ]
          },
          "place": {
            "$ref": "#/components/schemas/SavedPlaceResponseDto"
          }
        },
        "required": [
          "status",
          "place"
        ]
      },
      "TripResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "active": {
            "type": "boolean"
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "title",
          "destination",
          "timezone",
          "startDate",
          "endDate",
          "active"
        ]
      },
      "CreateTripDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "서울 가을 여행",
            "maxLength": 120
          },
          "destination": {
            "type": "string",
            "example": "서울",
            "maxLength": 120
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul",
            "maxLength": 64
          },
          "startDate": {
            "type": "string",
            "example": "2026-10-31",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "example": "2026-11-02",
            "format": "date"
          }
        },
        "required": [
          "title",
          "destination",
          "timezone",
          "startDate",
          "endDate"
        ]
      }
    }
  }
}
